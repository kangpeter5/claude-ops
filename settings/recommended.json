{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh release create *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl rollout *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(pulumi up *)",
      "Bash(vercel --prod *)",
      "Bash(flyctl deploy *)",
      "Bash(fly deploy *)",
      "Bash(serverless deploy *)",
      "Bash(sls deploy *)",
      "Bash(docker push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/claude-ops/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
